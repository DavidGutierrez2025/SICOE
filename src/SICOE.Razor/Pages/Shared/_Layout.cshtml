@inject IConfiguration Configuration
<!DOCTYPE html>
<html lang="es">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>@ViewData["Title"] - SICOE</title>
    <link rel="stylesheet" href="~/lib/bootstrap/dist/css/bootstrap.min.css" />
    <link rel="stylesheet" href="https://cdn.jsdelivr.net/npm/bootstrap-icons@1.11.0/font/bootstrap-icons.css" />
    <link rel="stylesheet" href="~/css/site.css" asp-append-version="true" />
    <link rel="stylesheet" href="~/SICOE.Razor.styles.css" asp-append-version="true" />
    <link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.0.0/css/all.min.css" />
    
    <style>
        /* Sidebar Styles */
        #wrapper {
            display: flex;
            width: 100%;
            min-height: 100vh;
        }

        #sidebar-wrapper {
            min-height: 100vh;
            width: 250px;
            margin-left: 0;
            background-color: var(--bg-sidebar);
            color: #fff;
            transition: margin .25s ease-out;
            position: fixed;
            z-index: 1000;
        }

        #page-content-wrapper {
            width: 100%;
            margin-left: 250px; /* Width of sidebar */
            transition: margin .25s ease-out;
        }

        .sidebar-heading {
            padding: 1.5rem 1.25rem;
            font-size: 1.5rem;
            font-weight: bold;
            text-align: center;
            border-bottom: 1px solid rgba(255, 255, 255, 0.1);
        }

        .list-group-item {
            background-color: transparent;
            color: rgba(255, 255, 255, 0.8);
            border: none;
            padding: 1rem 1.5rem;
        }

        .list-group-item:hover {
            background-color: rgba(255, 255, 255, 0.1);
            color: #fff;
        }
        
        .list-group-item.active {
            background-color: var(--accent-color);
            color: #fff;
            border-left: 4px solid #fff;
        }

        .list-group-item i {
            margin-right: 10px;
            width: 20px;
            text-align: center;
        }
        
        /* Topbar */
        .topbar {
            height: 4.375rem;
            background-color: var(--bg-card);
            box-shadow: 0 .15rem 1.75rem 0 rgba(58,59,69,.15);
            margin-bottom: 1.5rem;
            display: flex;
            align-items: center;
            justify-content: space-between;
            padding: 0 1.5rem;
        }
        
        [data-theme="dark"] .topbar {
            box-shadow: 0 .15rem 1.75rem 0 rgba(0,0,0,.5);
        }

        /* Toggle Button */
        #menu-toggle {
            cursor: pointer;
            color: var(--primary-color);
        }
        
        [data-theme="dark"] #menu-toggle {
            color: var(--text-main);
        }

        /* Content */
        .container-fluid {
            padding: 1rem 1.5rem;
        }
        
        @@media (max-width: 768px) {
            #sidebar-wrapper {
                margin-left: -250px;
            }
            #page-content-wrapper {
                margin-left: 0;
            }
            #wrapper.toggled #sidebar-wrapper {
                margin-left: 0;
            }
        }
    </style>
</head>
<body>

    <div class="d-flex" id="wrapper">
        <!-- Sidebar -->
        <div id="sidebar-wrapper">
            <div class="sidebar-heading">
                SICOE
            </div>
            
            <div class="list-group list-group-flush mt-3">
                <a asp-page="/Index" class="list-group-item list-group-item-action @(ViewContext.RouteData.Values["page"]?.ToString() == "/Index" ? "active" : "")">
                     <i class="fas fa-download"></i> Solicitar Descarga
                </a>
                <a asp-page="/CFDIProcesados" class="list-group-item list-group-item-action @(ViewContext.RouteData.Values["page"]?.ToString() == "/CFDIProcesados" ? "active" : "")">
                     <i class="fas fa-file-invoice"></i> CFDI Procesados
                </a>
                
                <div class="mt-auto">
                    <a href="#" class="list-group-item list-group-item-action" id="darkModeToggleSidebar">
                        <i class="fas fa-moon"></i> Modo Oscuro
                    </a>
                </div>
            </div>
        </div>
        <!-- /#sidebar-wrapper -->

        <!-- Page Content -->
        <div id="page-content-wrapper">
            <nav class="navbar navbar-expand-lg navbar-light topbar mb-4 static-top">
                <button class="btn btn-link rounded-circle mr-3" id="menu-toggle">
                    <i class="fa fa-bars"></i>
                </button>

                <ul class="navbar-nav ml-auto ms-auto d-flex align-items-center">
                    
                    <!-- Dark Mode Toggle -->
                    <li class="nav-item mx-2">
                        <button class="btn btn-link nav-link" id="theme-toggle">
                            <i class="bi bi-moon-fill"></i>
                        </button>
                    </li>

                    <div class="topbar-divider d-none d-sm-block border-right mx-2 h-100" style="border-right: 1px solid var(--border-color);"></div>

                    <!-- User Information -->
                    <li class="nav-item dropdown no-arrow">
                        <a class="nav-link dropdown-toggle d-flex align-items-center" href="#" id="userDropdown" role="button" data-bs-toggle="dropdown" aria-haspopup="true" aria-expanded="false">
                            <span class="mr-2 d-none d-lg-inline text-gray-600 small me-2" style="color: var(--text-main);" id="userDisplayRfc">Usuario Demo</span>
                            <div class="rounded-circle bg-secondary d-flex align-items-center justify-content-center text-white" style="width: 32px; height: 32px;">
                                <i class="fas fa-user"></i>
                            </div>
                        </a>
                        <div class="dropdown-menu dropdown-menu-end shadow animated--grow-in" aria-labelledby="userDropdown" style="background-color: var(--bg-card); border-color: var(--border-color);">
                            <a class="dropdown-item" href="#" style="color: var(--text-main);">
                                <i class="fas fa-user fa-sm fa-fw mr-2 text-gray-400"></i>
                                Perfil
                            </a>
                            <div class="dropdown-divider" style="border-color: var(--border-color);"></div>
                            <a class="dropdown-item" href="#" onclick="cerrarSesion(); return false;" style="color: var(--text-main);">
                                <i class="fas fa-sign-out-alt fa-sm fa-fw mr-2 text-gray-400"></i>
                                Salir
                            </a>
                        </div>
                    </li>
                </ul>
            </nav>

            <div class="container-fluid">
                @RenderBody()
            </div>
            
            <footer class="sticky-footer bg-white mt-auto py-3">
                <div class="container my-auto">
                    <div class="copyright text-center my-auto">
                        <span style="color: var(--text-muted);">&copy; 2025 GEDINET SICOE - Todos los derechos reservados</span>
                    </div>
                </div>
            </footer>
        </div>
        <!-- /#page-content-wrapper -->
    </div>

    <script src="~/lib/jquery/dist/jquery.min.js"></script>
    <script src="~/lib/bootstrap/dist/js/bootstrap.bundle.min.js"></script>
    <script src="~/js/site.js" asp-append-version="true"></script>
    <script>
        // Configuración global del API
        window.apiBaseUrl = '@(Configuration["Api:BaseUrl"] ?? "https://localhost:7052")';
        
        $("#menu-toggle").click(function(e) {
            e.preventDefault();
            $("#wrapper").toggleClass("toggled");
        });

        /**
         * Cierra la sesión del usuario, limpia sessionStorage y redirige al login
         */
        function cerrarSesion() {
            // Limpiar toda la sesión FIEL de sessionStorage
            sessionStorage.removeItem('sicoe_fiel_session');
            sessionStorage.removeItem('satToken');
            sessionStorage.removeItem('tokenExpiration');
            sessionStorage.removeItem('userRfc');
            
            console.log('Sesión cerrada. Redirigiendo al login...');
            
            // Redirigir a la página de login (raíz)
            window.location.href = '/';
        }
    </script>

    @await RenderSectionAsync("Scripts", required: false)
</body>
</html>
