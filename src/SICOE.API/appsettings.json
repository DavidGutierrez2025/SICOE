{
  "ConnectionStrings": {
    "SICOEConnectionString": "Server=(localdb)\\MSSQLLocalDB;Database=SICOE;Trusted_Connection=True;TrustServerCertificate=True;"
  },
  "Storage": {
    "BasePath": "",
    "MaxFileSize": 10485760,
    "AllowedExtensions": [ ".xml", ".pdf", ".xlsx", ".csv" ]
  },
  "Sat": {
    "BaseUrl": "https://cfdidescargamasivasolicitud.clouda.sat.gob.mx",
    "DescargaBaseUrl": "https://cfdidescargamasiva.clouda.sat.gob.mx",
    "AutenticacionUrl": "https://cfdidescargamasivasolicitud.clouda.sat.gob.mx/Autenticacion/Autenticacion.svc",
    "TimeoutSegundos": 300,
    "MaxReintentos": 3
  },
  "Serilog": {
    "Using": [ "Serilog.Sinks.Console", "Serilog.Sinks.File" ],
    "MinimumLevel": {
      "Default": "Information",
      "Override": {
        "Microsoft": "Warning",
        "Microsoft.AspNetCore": "Warning",
        "System": "Warning",
        "Hangfire": "Information"
      }
    },
    "WriteTo": [
      {
        "Name": "Console",
        "Args": {
          "outputTemplate": "[{Timestamp:HH:mm:ss} {Level:u3}] {Message:lj} {Properties:j}{NewLine}{Exception}"
        }
      },
      {
        "Name": "File",
        "Args": {
          "path": "logs/sicoe-api-.log",
          "rollingInterval": "Day",
          "retainedFileCountLimit": 30,
          "outputTemplate": "[{Timestamp:yyyy-MM-dd HH:mm:ss.fff zzz} {Level:u3}] {Message:lj} {Properties:j}{NewLine}{Exception}"
        }
      }
    ],
    "Enrich": [ "FromLogContext", "WithMachineName", "WithThreadId" ]
  },
  "Logging": {
    "LogLevel": {
      "Default": "Information",
      "Microsoft.AspNetCore": "Warning"
    }
  },
  "AllowedHosts": "*"
}
